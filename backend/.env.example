# Copy this file to backend/.env and fill it in. Never commit the real .env.

# --- Firebase (needed for sign-in checks and for saving anything) -------------------
# Either point to the service account key file...
#   Firebase Console > Project Settings > Service Accounts > Generate new private key.
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json
# ...or, on a host that keeps secrets in environment variables, put the whole key's JSON
# in this variable instead (it is used first when both are set).
# FIREBASE_SERVICE_ACCOUNT_JSON=

# Comma-separated emails that are treated as administrators when they sign in (FR-01).
ADMIN_EMAILS=admin@uniguide.ac.ke

# --- Web admin portal ---------------------------------------------------------------
# Websites allowed to call the API from a browser (the phone app is not affected).
# CORS_ORIGINS=https://your-portal.pages.dev

# --- Trained model on a server that does not hold the file ---------------------------
# The server downloads the model once and refuses it unless its SHA-256 matches.
# Get both values from `python package_model.py` and the place you uploaded the file to.
# MODEL_URL=
# MODEL_SHA256=
# MODEL_TOKEN=          # only if the download needs a bearer token (private repository)

# --- Abuse limits (defaults shown) --------------------------------------------------
# RATE_LIMIT_REQUESTS=30
# RATE_LIMIT_WINDOW_SECONDS=60

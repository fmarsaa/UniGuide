# Path to the Firebase service account JSON key used by firebase-admin.
# Firebase Console > Project Settings > Service Accounts > Generate new private key.
# Required for authentication (/api/auth/whoami, /api/recommend, /api/feedback)
# and for Firestore persistence. Without it the backend still starts and serves
# pure ML inference is disabled on auth-gated routes (they return 503).
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# Comma-separated allowlist of email addresses that should be treated as
# UniGuide administrators the first time they sign in (see FR-01).
ADMIN_EMAILS=admin@uniguide.ac.ke

# Flutter
**/.dart_tool/
**/build/
**/.flutter-plugins
**/.flutter-plugins-dependencies
**/.packages
# Regenerated by Flutter tooling from pubspec.yaml on every build - committing
# it risks a stale copy (missing newly-added plugins) shadowing the real one.
**/GeneratedPluginRegistrant.*

# Android
**/.gradle/
**/local.properties
**/captures/

# IDE
.idea/
.vscode/
*.iml

# Claude Code tooling state (not project source)
.claude/
.agents/
skills-lock.json

# Python
**/__pycache__/
**/*.py[cod]
**/.venv/
**/venv/

# Environment and secrets
.env
.env.*
!.env.example
**/serviceAccountKey.json
**/*firebase-adminsdk*.json
flutter_app/android/app/google-services.json

# Trained model artifacts (regenerate with train_random_forest.py)
backend/rf_model_pipeline.pkl
backend/model_metrics.json
backend/synthetic_student_profiles.csv
backend/model_backups/

# Build logs
flutter_app/build_output.txt

# OS
.DS_Store
Thumbs.db

# Official KUCCPS source PDFs used for catalogue verification (public, large - download them again from kuccps.net)
catalogue_verification/*.pdf

# Firebase web config for the admin portal (build-time settings, kept out of git like google-services.json)
flutter_app/web_firebase.json

# Real student session data (never commit)
ml/experiments/student_evaluation/sessions.csv

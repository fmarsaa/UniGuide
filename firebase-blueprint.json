{
  "entities": {
    "Admin": {
      "title": "Admin",
      "description": "Institutional administrator with oversight on cutoffs and audit logs",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Admin UID" },
        "email": { "type": "string", "format": "email", "description": "Institutional email address" },
        "fullName": { "type": "string", "description": "Administrator full name" },
        "role": { "type": "string", "enum": ["admin"], "description": "Role identifier" },
        "faculty": { "type": "string", "description": "Faculty or department assigned" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Timestamp of account creation" }
      },
      "required": ["uid", "email", "fullName", "role"]
    },
    "Student": {
      "title": "Student",
      "description": "KCSE high school candidate seeking degree recommendations",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Student UID" },
        "email": { "type": "string", "format": "email", "description": "Candidate email address" },
        "fullName": { "type": "string", "description": "Candidate full name" },
        "indexNumber": { "type": "string", "description": "KCSE Index Number format: 12345678/2025" },
        "role": { "type": "string", "enum": ["student"], "description": "Role identifier" },
        "kcseMeanGrade": { "type": "string", "description": "Candidate KCSE Mean Grade" },
        "kcseMeanPoints": { "type": "number", "description": "Total aggregate points (max 84)" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Timestamp of registration" }
      },
      "required": ["uid", "email", "fullName", "indexNumber", "role"]
    },
    "Programme": {
      "title": "Programme",
      "description": "KUCCPS accredited university undergraduate degree programme",
      "type": "object",
      "properties": {
        "code": { "type": "string", "description": "Official KUCCPS programme code" },
        "name": { "type": "string", "description": "Degree title" },
        "faculty": { "type": "string", "description": "Faculty or School" },
        "durationYears": { "type": "number", "description": "Duration in academic years" },
        "category": { "type": "string", "description": "Academic discipline category" },
        "overview": { "type": "string", "description": "Curriculum overview" },
        "clusterSubjectGroup": { "type": "string", "description": "Four KUCCPS cluster subjects" },
        "minimumMeanGrade": { "type": "string", "description": "Minimum required KCSE mean grade" }
      },
      "required": ["code", "name", "faculty", "durationYears", "category"]
    },
    "Recommendation": {
      "title": "Recommendation",
      "description": "System-generated top-3 degree recommendation with KUCCPS cluster scores and SHAP explainability",
      "type": "object",
      "properties": {
        "programmeId": { "type": "string", "description": "Referenced programme identifier" },
        "programmeName": { "type": "string", "description": "Degree title" },
        "rank": { "type": "number", "description": "Rank position (1, 2, or 3)" },
        "confidence": { "type": "number", "description": "Confidence percentage" },
        "matchRationale": { "type": "string", "description": "Rationale for recommendation" },
        "studentClusterScore": { "type": "number", "description": "Student calculated KUCCPS cluster point" },
        "targetCutoff": { "type": "number", "description": "University cutoff points threshold" },
        "timestamp": { "type": "string", "format": "date-time", "description": "Inference timestamp" }
      },
      "required": ["programmeId", "programmeName", "rank", "confidence"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Administrative audit trail of system operations and inferences",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Log entry identifier" },
        "timestamp": { "type": "string", "format": "date-time", "description": "Timestamp" },
        "action": { "type": "string", "description": "Action performed" },
        "actor": { "type": "string", "description": "User or system agent performing action" },
        "details": { "type": "string", "description": "Contextual details" }
      },
      "required": ["id", "timestamp", "action", "actor"]
    },
    "Feedback": {
      "title": "Feedback",
      "description": "Student evaluation and qualitative feedback on recommendations",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Feedback identifier" },
        "studentEmail": { "type": "string", "description": "Candidate email" },
        "rating": { "type": "number", "description": "Likert rating 1 to 5" },
        "isAlignedWithCareer": { "type": "boolean", "description": "Career alignment confirmation" },
        "comments": { "type": "string", "description": "Student remarks" },
        "timestamp": { "type": "string", "format": "date-time", "description": "Submission time" }
      },
      "required": ["id", "rating", "timestamp"]
    }
  },
  "firestore": {
    "/admins/{adminId}": {
      "schema": "Admin",
      "description": "Admins collection storing institutional administrators"
    },
    "/students/{studentId}": {
      "schema": "Student",
      "description": "Students collection storing candidates and KCSE credentials"
    },
    "/students/{studentId}/recommendations/{recommendationId}": {
      "schema": "Recommendation",
      "description": "Candidate top-3 recommendations and explainability scores"
    },
    "/programmes/{programmeId}": {
      "schema": "Programme",
      "description": "Official KUCCPS degree catalog with cutoffs and clusters"
    },
    "/audit_logs/{logId}": {
      "schema": "AuditLog",
      "description": "System and administrative action logs"
    },
    "/feedback/{feedbackId}": {
      "schema": "Feedback",
      "description": "Student satisfaction and accuracy feedback submissions"
    }
  }
}

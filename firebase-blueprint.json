{
  "_note": "Documents the Firestore schema as actually written by backend/main.py and backend/programmes_catalog.py. Regenerate this by hand if either changes - it is documentation only, nothing reads this file at runtime.",
  "entities": {
    "Admin": {
      "title": "Admin",
      "description": "Administrator account, granted the role on first sign-in if their email is in ADMIN_EMAILS (backend/.env)",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth UID" },
        "email": { "type": "string", "format": "email" },
        "role": { "type": "string", "enum": ["admin"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "role"]
    },
    "Student": {
      "title": "Student",
      "description": "KCSE candidate profile, upserted by POST /api/recommend and created with defaults by POST /api/auth/whoami on first sign-in",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth UID" },
        "email": { "type": "string", "format": "email" },
        "fullName": { "type": "string" },
        "indexNumber": { "type": "string", "description": "KCSE Index Number, e.g. 12345678/2025" },
        "role": { "type": "string", "enum": ["student"] },
        "kcseMeanGrade": { "type": "string", "description": "e.g. B+" },
        "kcseMeanPoints": { "type": "number", "description": "1-12" },
        "grades": {
          "type": "object",
          "description": "Subject name -> letter grade, e.g. {\"Mathematics\": \"A\", \"Kiswahili\": \"B\"}"
        },
        "interests": { "type": "array", "items": { "type": "string" } },
        "skills": { "type": "array", "items": { "type": "string" } },
        "strengths": { "type": "array", "items": { "type": "string" } },
        "aspirations": { "type": "array", "items": { "type": "string" } },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "role"]
    },
    "Programme": {
      "title": "Programme",
      "description": "University degree programme; the class label the Random Forest model predicts. Full catalog in backend/programmes_catalog.py, mirrored in flutter_app/lib/data/programme_repository.dart",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "code": { "type": "string" },
        "title": { "type": "string", "description": "Degree title - also the exact string the RF model predicts as a class label" },
        "faculty": { "type": "string" },
        "minMeanGrade": { "type": "string" },
        "averageCutoff": { "type": "number", "description": "KUCCPS Cluster Weighted Points cutoff" },
        "clusterGroup": { "type": "string" },
        "clusterSubjects": { "type": "array", "items": { "type": "string" } },
        "minimumSubjectRequirements": { "type": "object", "description": "Subject name -> minimum letter grade" },
        "description": { "type": "string" },
        "careerOpportunities": { "type": "array", "items": { "type": "string" } },
        "requiredSkills": { "type": "array", "items": { "type": "string" } },
        "professionalCertifications": { "type": "array", "items": { "type": "string" } },
        "offeringUniversities": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "universityName": { "type": "string" },
              "universityType": { "type": "string" },
              "location": { "type": "string" },
              "latestCutoff": { "type": "number" },
              "previousCutoff": { "type": "number" },
              "kuccpsCode": { "type": "string" }
            }
          }
        },
        "durationYears": { "type": "number" }
      },
      "required": ["id", "code", "title", "faculty", "averageCutoff"]
    },
    "RecommendationBatch": {
      "title": "RecommendationBatch",
      "description": "One /api/recommend response, persisted as a single document holding all 3 ranked recommendations (not one document per recommendation)",
      "type": "object",
      "properties": {
        "createdAt": { "type": "string", "format": "date-time" },
        "recommendations": {
          "type": "array",
          "description": "Exactly 3 items, rank 1-3, highest confidence first",
          "items": {
            "type": "object",
            "properties": {
              "rank": { "type": "number" },
              "confidenceScore": { "type": "number", "description": "0.0-1.0, from RandomForestClassifier.predict_proba" },
              "studentClusterScore": { "type": "number", "description": "Computed KUCCPS CWP for this programme's cluster subjects" },
              "cutoffDiff": { "type": "number" },
              "eligibilityStatus": { "type": "string" },
              "primaryReason": { "type": "string" },
              "programme": { "$ref": "#/entities/Programme" },
              "shapExplanations": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "featureName": { "type": "string" },
                    "category": { "type": "string", "enum": ["Academic", "Interests", "Skills", "Strengths", "Aspirations"] },
                    "shapValue": { "type": "number" },
                    "description": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Written by PUT /api/admin/programmes/{id}; read back by GET /api/admin/audit-logs",
      "type": "object",
      "properties": {
        "action": { "type": "string" },
        "actor": { "type": "string", "description": "Admin's email, or uid if email unavailable" },
        "details": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["action", "actor", "timestamp"]
    },
    "Feedback": {
      "title": "Feedback",
      "description": "Written by POST /api/feedback",
      "type": "object",
      "properties": {
        "recommendationId": { "type": "string", "description": "The programme id the feedback is about" },
        "rating": { "type": "number", "description": "1-5" },
        "comments": { "type": "string" },
        "submittedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["recommendationId", "rating"]
    }
  },
  "firestore": {
    "/admins/{uid}": { "schema": "Admin" },
    "/students/{uid}": { "schema": "Student" },
    "/students/{uid}/recommendations/{autoId}": { "schema": "RecommendationBatch" },
    "/students/{uid}/feedback/{autoId}": { "schema": "Feedback" },
    "/programmes/{programmeId}": { "schema": "Programme", "description": "Seeded from programmes_catalog.py on first read if empty" },
    "/audit_logs/{autoId}": { "schema": "AuditLog" }
  }
}

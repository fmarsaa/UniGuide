rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // All reads and writes go through the FastAPI backend (backend/main.py),
    // which authenticates callers via Firebase Auth ID tokens and then uses
    // the Firebase Admin SDK - which is NOT subject to these rules - to
    // perform CRUD operations (see proposal IR-05). These rules exist purely
    // as defense-in-depth: they deny every direct client SDK/REST request,
    // authenticated or not, so a leaked API key or a bug elsewhere can never
    // expose student data straight from Firestore.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
